# ============================================================
#  SAMER — config Apache (hébergement mutualisé, ex. LWS)
#  Copié automatiquement dans dist/ au build (depuis public/).
# ============================================================

RewriteEngine On

# --- SPA fallback (ESSENTIEL) ---------------------------------
# Toute URL qui ne correspond pas à un fichier/dossier réel est
# servie par index.html ; Expo Router gère ensuite la route côté
# navigateur. Sans ça : erreur 404 au rechargement d'une page profonde.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# --- HTTPS ----------------------------------------------------
# Recommandé : activer plutôt « Forcer HTTPS » dans le panel LWS.
# Si tu préfères le faire ici, décommente les 2 lignes ci-dessous.
# ⚠️ En cas de boucle de redirection, supprime-les et utilise le panel.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Cache (optionnel mais conseillé) -------------------------
# Assets versionnés (noms avec hash) = cache long ; index.html = jamais en cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Service worker : JAMAIS en cache long, sinon les mises à jour du push
  # (sw.js) ne se propagent plus. Doit passer APRÈS la règle .js ci-dessus.
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
